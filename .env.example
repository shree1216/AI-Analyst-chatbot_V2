# Azure OpenAI settings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_MINI=

# Azure Speech settings
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Gmail SMTP settings
# Create a Google App Password with two-step verification enabled; do not use your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
# Data source: sqlserver (local Windows setup) or demo (bundled synthetic data).
# In Streamlit Community Cloud, set WORKFORCE_DATA_MODE = "demo" in app secrets.
WORKFORCE_DATA_MODE=sqlserver
# SQL Server connection. Defaults keep the local Windows-authenticated setup.
WORKFORCE_SQL_SERVER=localhost\SQLEXPRESS
WORKFORCE_SQL_DATABASE=EmployeeDB
WORKFORCE_SQL_DRIVER=ODBC Driver 17 for SQL Server
# Optional TCP port, normally 1433 for a hosted SQL Server.
WORKFORCE_SQL_PORT=
# Leave both empty for Windows authentication. Hosted SQL authentication requires both.
# Set the password only in .env locally or the deployment secret manager.
# SQL authentication always uses encryption and validates the server certificate.
WORKFORCE_SQL_USERNAME=
WORKFORCE_SQL_PASSWORD=
